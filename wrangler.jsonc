{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "purbalink--admin",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-18",
  "build": {
    "command": "node scripts/build-media.mjs",
    "watch_dir": [
      "sticker",
      "scripts"
    ]
  },
  "vars": {
    "MIDTRANS_MODE": "sandbox",
    "ADMIN_EMAIL": "amelnewsid@gmail.com",
    "AI_PROVIDER_ORDER": "openrouter,groq,gemini,deepseek,mistral,together,openai,anthropic"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "purbalink-db",
      "database_id": "ccd6e6ed-3b68-42e1-ab03-abe7829193bc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "purbalink-media"
    }
  ],
  "routes": [
    {
      "pattern": "purbalink.web.id",
      "custom_domain": true
    },
    {
      "pattern": "admin.purbalink.web.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  }
}
